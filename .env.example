# Ключ шифрования базы: 64 символа 0-9a-f. Получить: npm run gen-key
# ВАЖНО: сохраните копию ключа отдельно (менеджер паролей). Потеря ключа = потеря данных.
DB_KEY=

# Хеш пароля входа (не сам пароль!). Получить: npm run hash-password
PASSWORD_HASH=

# Путь к файлу базы
DB_PATH=data/app.db

# Токен для /api/reminders (понадобится в Фазе 3)
REMINDERS_TOKEN=

# --- Только на сервере (за nginx) ---
# Адрес приложения, нужен для защиты форм:
# ORIGIN=https://example.ru
# Настоящий IP посетителя от nginx (для ограничения попыток входа):
# ADDRESS_HEADER=X-Real-IP
# Порт и адрес, на которых слушает приложение:
# HOST=127.0.0.1
# PORT=3000
