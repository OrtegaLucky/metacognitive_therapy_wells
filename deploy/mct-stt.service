# Служба распознавания речи faster-whisper (SPEC 12.3). Только 127.0.0.1:3012.
# Установка: deploy/setup-stt.sh на сервере.
[Unit]
Description=MCT: распознавание речи faster-whisper
After=network.target

[Service]
Type=simple
User=mct
Group=mct
WorkingDirectory=/opt/mct/app/stt
Environment=STT_MODEL=small
Environment=STT_MODELS_DIR=/opt/mct/stt-models
Environment=STT_PORT=3012
Environment=STT_THREADS=4
Environment=HF_HUB_OFFLINE=1
ExecStart=/opt/mct/stt-venv/bin/python -u /opt/mct/app/stt/server.py
Restart=on-failure
RestartSec=5

# Не мешать остальным службам сервера
CPUQuota=300%
MemoryMax=2500M
Nice=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
UMask=0077

[Install]
WantedBy=multi-user.target
